{
  "name": "rsmbtv",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22 <27",
    "npm": ">=11 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build-blog:dev && npm run build-flights && vite",
    "build": "npm run build-flights && npm run build-blog && npm run typecheck && vite build",
    "build-blog": "npm run sync-blogs && npm run build-blog-artifacts",
    "build-blog:dev": "npm run sync-blogs:dev && npm run build-blog-artifacts",
    "build-blog-artifacts": "npm run build-og && npm run build-rss && npm run build-sitemap",
    "build-flights": "node projects/flights/scripts/convertFlights.js && node projects/flights/scripts/generateAllAirports.js && node projects/flights/scripts/generateUSStates.js",
    "build-og": "node scripts/generate-og-images.js",
    "build-rss": "node scripts/generate-rss.js",
    "build-sitemap": "node scripts/generate-sitemap.js",
    "generate-mappings": "node projects/flights/scripts/generateNameMappings.js",
    "backfill": "node scripts/backfill.js",
    "sync-blogs": "node scripts/sync-blogs.js",
    "sync-blogs:dev": "node scripts/sync-blogs-dev.js",
    "sync-flights": "node scripts/sync-flights.js",
    "sync-temperatures": "node scripts/sync-temperatures.js",
    "sync-tornadoes": "node projects/tornado-tracks/scripts/syncTornadoes.js",
    "aws-status": "bash scripts/aws-status.sh",
    "watch": "node --env-file-if-exists=.env.local --import tsx/esm scripts/aws-watch.tsx",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "bundle-report": "node scripts/bundle-report.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright.js",
    "audit": "npm audit --audit-level=moderate",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1102.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1085.0",
    "@aws-sdk/client-cloudwatch": "^3.1084.0",
    "@aws-sdk/client-cost-explorer": "^3.1097.0",
    "@aws-sdk/client-route-53": "^3.1106.0",
    "@aws-sdk/credential-providers": "^3.1103.0",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.61.0",
    "@shikijs/rehype": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "csv-parse": "^7.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "i18n-iso-countries": "^7.14.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "iso-3166-2": "^1.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "turndown": "^7.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "undici": "^7.29.0",
    "react-router": "8.3.0"
  }
}
