{
  "name": "rsmbtv",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0",
    "npm": ">=12.2 <13"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run prepare-trip-assets:dev && npm run build-blog:dev && npm run build-flights && vite --port 5173 --strictPort",
    "build": "npm run build-flights && npm run build-blog && npm run typecheck && vite build",
    "build-blog": "npm run sync-blogs && npm run build-blog-artifacts",
    "build-blog:dev": "npm run sync-blogs:dev && npm run build-blog-artifacts",
    "build-blog-artifacts": "npm run build-og && npm run build-rss && npm run build-sitemap",
    "build-flights": "node projects/flights/scripts/convertFlights.js && node projects/flights/scripts/generateAllAirports.js && node projects/flights/scripts/generateUSStates.js",
    "build-og": "node scripts/generate-og-images.js",
    "build-rss": "node scripts/generate-rss.js",
    "build-sitemap": "node scripts/generate-sitemap.js",
    "generate-mappings": "node projects/flights/scripts/generateNameMappings.js",
    "backfill": "node scripts/backfill.js",
    "sync-blogs": "node scripts/sync-blogs.js",
    "sync-blogs:dev": "node scripts/sync-blogs-dev.js",
    "sync-flights": "node scripts/sync-flights.js",
    "sync-temperatures": "node scripts/sync-temperatures.js",
    "sync-tornadoes": "node projects/tornado-tracks/scripts/syncTornadoes.js",
    "prepare-trip-assets": "node scripts/prepare-trip-assets.js",
    "prepare-trip-assets:dev": "node scripts/prepare-trip-assets-dev.js",
    "publish-trip-assets": "node scripts/publish-trip-assets.js",
    "aws-status": "bash scripts/aws-status.sh",
    "watch": "node --env-file-if-exists=.env.local --import tsx/esm scripts/aws-watch.tsx",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "bundle-report": "node scripts/bundle-report.js",
    "preview": "vite preview",
    "test": "vitest run && npm run test:temperature-records",
    "test:temperature-records": "cd projects/temperature-records && python3 -m unittest discover -s tests -v",
    "test:e2e": "node scripts/run-playwright.js",
    "audit": "npm audit --audit-level=moderate",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky",
    "test:trips:browser": "node scripts/run-trip-browser-tests.js",
    "update-trip-manifest-assets": "node scripts/update-trip-manifest-assets.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1147.0",
    "maplibre-gl": "^6.13.0",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1147.0",
    "@aws-sdk/client-cloudwatch": "^3.1147.0",
    "@aws-sdk/client-cost-explorer": "^3.1147.0",
    "@aws-sdk/client-route-53": "^3.1147.0",
    "@aws-sdk/credential-providers": "^3.1147.0",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.63.0",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tmcw/togeojson": "^7.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "i18n-iso-countries": "^7.14.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "iso-3166-2": "^1.0.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "remark-frontmatter": "^5.0.0",
    "sharp": "^0.35.5",
    "simplify-js": "^1.2.4",
    "tailwindcss": "^4.3.3",
    "terminal-size": "^4.0.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
