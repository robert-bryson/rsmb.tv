# Local environment variables — copy to .env.local and fill in values
# .env.local is gitignored and is loaded by local scripts such as
# `npm run watch`, `npm run sync-blogs`, and `npm run dev`.

# GitHub personal access token (read-only, for Actions build status)
# Create at: https://github.com/settings/tokens → Fine-grained → Read-only Actions
GITHUB_TOKEN=

# Amplify app IDs — comma-separated name=id pairs
# Run: aws amplify list-apps --query 'apps[].{name:name,id:appId}'
AMPLIFY_APP_IDS=rsmb.tv=XXXX,route2gpx=XXXX

# Route53 health check IDs — comma-separated name=id pairs
# Run: aws route53 list-health-checks --query 'HealthChecks[].{domain:HealthCheckConfig.FullyQualifiedDomainName,id:Id}'
HEALTH_CHECK_IDS=rsmb.tv=XXXX,bookend=XXXX

# Blog publishing sync — used by `npm run sync-blogs` and `npm run dev`
GOOGLE_BLOG_SHEET_ID=
GOOGLE_BLOG_SHEET_NAME=Blog Posts
GOOGLE_BLOG_REPLACE_ALL=false
GOOGLE_BLOG_SYNC_ON_DEV=true
